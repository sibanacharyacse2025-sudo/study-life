<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:id="@+id/llMessageContainer"
    android:orientation="vertical">

    <!-- User Message (Right aligned) -->
    <LinearLayout
        android:id="@+id/llUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_user_message_rounded"
        android:maxWidth="280dp"
        android:padding="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <!-- AI Message (Left aligned) -->
    <LinearLayout
        android:id="@+id/llAiMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_ai_message_rounded"
        android:maxWidth="280dp"
        android:padding="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2E5090"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</LinearLayout>