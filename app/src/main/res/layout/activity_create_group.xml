<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_yellow_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header_blue"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_add"
            android:contentDescription="Create Group"
            android:tint="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Community Group"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teachers and seniors only"
            android:textColor="#E3F2FD"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Form Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Group Name Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group Name"
                android:textColor="#2E5090"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etGroupName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="e.g., JEE Main Preparation 2024"
                android:textColorHint="#A1887F"
                android:textColor="#3E2723"
                android:textSize="15sp"
                android:background="@drawable/input_field_rounded"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp" />

            <!-- Description Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group Description"
                android:textColor="#2E5090"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etGroupDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Share the purpose and topics of this group..."
                android:textColorHint="#A1887F"
                android:textColor="#3E2723"
                android:textSize="14sp"
                android:background="@drawable/input_field_rounded"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginBottom="20dp" />

            <!-- Category Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group Category"
                android:textColor="#2E5090"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/llCategoryOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnCatStudies"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="📚 Studies"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_primary_yellow"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnCatProjects"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="🚀 Projects"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_mood_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnCatCareer"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="💼 Career"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_mood_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnCatMisc"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="💬 General"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_mood_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Privacy Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ai_message_rounded"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Group Guidelines"
                    android:textColor="#2E5090"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Keep discussions relevant and respectful\n✓ No spam or inappropriate content\n✓ All members should follow SFW guidelines\n✓ You can invite members after group creation"
                    android:textColor="#3E2723"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E5090"
            android:background="@drawable/button_mood_selector"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCreateGroup"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Create Group"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary_yellow" />

    </LinearLayout>

</LinearLayout>
