<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_yellow_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/logo_books"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="24dp" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="StudyLife"
        android:textColor="#2E5090"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Study Life - Better Way to Learn"
        android:textColor="#6D4C41"
        android:textSize="16sp"
        android:textStyle="italic" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Join thousands of students improving their learning journey with personalized AI assistance, study tracking, and community support."
        android:textColor="#5D4037"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- Student Button -->
    <Button
        android:id="@+id/btnStudent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/continue_as_student"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_primary_yellow"
        android:stateListAnimator="@null" />

    <!-- Teacher Button -->
    <Button
        android:id="@+id/btnTeacher"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/continue_as_teacher"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_primary_yellow"
        android:stateListAnimator="@null" />

    <!-- Guest Button -->
    <Button
        android:id="@+id/btnGuest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="@string/continue_as_guest"
        android:textSize="16sp"
        android:textColor="#2E5090"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null" />

    <!-- Sign Up Link -->
    <TextView
        android:id="@+id/tvSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New here? Sign Up"
        android:textColor="#2E5090"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>